        "generation_config.json",
        "model.safetensors",
        "tokenizer.model"
      ],
      "download": {
        "kind": "huggingface_snapshot",
        "repo": "syvai/hviske-v5.3"
      }
    }
  ],
  "sources": [
    {
      "format": "gguf",
      "roots": {
        "model": ".",
        "weights": "$gguf"
      },
      "files": {
